# ================================================================================
#                       ENVIRONMENT CONFIGURATION TEMPLATE
# ================================================================================
# Copy this file to .env and replace YOUR_PASSWORD with your actual Supabase database password.
# DO NOT COMMIT .env TO GIT REGISTRY!

# Supabase PostgreSQL Direct JDBC Connection String (Required for Java Backend)
# Project Reference: cqdyvlyqovcaigbvpxbt
SUPABASE_DB_URL=jdbc:postgresql://db.cqdyvlyqovcaigbvpxbt.supabase.co:5432/postgres?user=postgres&password=YOUR_PASSWORD&sslmode=require

# Java Backend REST API Server Port
PORT=8080

# Real Gmail SMTP Email Configuration (Optional - for sending real OTP emails to Gmail)
# Generate a 16-character App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=YOUR_GMAIL_ADDRESS@gmail.com
SMTP_PASS=YOUR_GMAIL_APP_PASSWORD
SMTP_FROM=LogAnalyzer PRO <YOUR_GMAIL_ADDRESS@gmail.com>
